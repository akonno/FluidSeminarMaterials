しい．","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"NUQeVgKJsE"}],"key":"YqzcsJTfyM"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"環境セットアップ (Windows 11 + Miniforge)","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"gGunvWeezh"}],"identifier":"id-windows-11-miniforge","label":"環境セットアップ (Windows 11 + Miniforge)","html_id":"id-windows-11-miniforge","implicit":true,"key":"pdng2qeIk9"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Miniforge Promptを開き、EXERCISE環境に入って、以下のコマンドを実行する。次の手順は、手動で作成する方法で環境を準備した場合の導入方法である。本教材ではpygame-ceをPyPIから導入するため、pipを使用する。","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Gcz2I0jE94"}],"key":"luKcBbxdVM"},{"type":"code","lang":"powershell","value":"conda activate EXERCISE     # EXERCISE環境に入る\npython -m pip install pygame-ce         # pygame-ceをインストール","position":{"start":{"line":25,"column":1},"end":{"line":28,"column":1}},"key":"GbSM3rFKhV"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"inlineCode","value":"environment.yml","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ch2DV1WPZJ"},{"type":"text","value":"から授業用環境を作成した場合は、pygame-ceもすでにインストールされているため、このpipコマンドは不要である。その場合も、","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"GAUfrQ6yWf"},{"type":"inlineCode","value":"conda activate EXERCISE","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"dUiPIGA5GQ"},{"type":"text","value":"を実行した状態で、次の動作確認やexamplesの実行を行える。","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"TymeT9UA2o"}],"key":"XD8YETzUOU"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":35,"column":1}},"children":[